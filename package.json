{
  "name": "pi-memory",
  "version": "1.0.0",
  "description": "跨会话长期记忆 for pi —— 自动抽取偏好/决定/背景，新会话时语义检索注入。Cross-session long-term memory: auto-extracts preferences and decisions, recalls them semantically into new sessions.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "long-term-memory",
    "cross-session",
    "semantic-search",
    "rag",
    "记忆",
    "跨会话记忆"
  ],
  "homepage": "https://github.com/MoeWang-ys/pi-memory#readme",
  "bugs": {
    "url": "https://github.com/MoeWang-ys/pi-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoeWang-ys/pi-memory.git"
  },
  "license": "MIT",
  "author": "MoeWang-ys",
  "files": [
    "extensions",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "pi-memory-setup": "./scripts/postinstall.mjs"
  },
  "scripts": {
    "setup": "node ./scripts/postinstall.mjs",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "typebox": ">=1.3.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pi": {
    "extensions": [
      "./extensions/memory.ts"
    ]
  }
}
